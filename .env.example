# Copy to .env (git-ignored) and set the same values in Vercel.
# Everything starting with VITE_ ends up in the browser, so never put secrets here.

# API the app talks to (required)
VITE_API_BASE_URL=https://optest.advertsedge.com/api

# Activity Log page
VITE_ACTIVITY_API_URL=http://127.0.0.1:5000/api/activity

# Realtime notifications (Pusher); leave blank to turn them off
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=

# Optional. Defaults to <API base URL>/broadcasting/auth
# VITE_PUSHER_AUTH_ENDPOINT=https://optest.advertsedge.com/api/broadcasting/auth
